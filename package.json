{
  "name": "@bintangtimurlangit/tokopedia-mcp",
  "version": "2.0.1",
  "description": "A zero-config MCP server for discovering Tokopedia — product search with full dynamic filtering, product detail, customer reviews, and shop info. No login required.",
  "author": "bintangtimurlangit",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bintangtimurlangit/tokopedia-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/bintangtimurlangit/tokopedia-mcp/issues"
  },
  "homepage": "https://github.com/bintangtimurlangit/tokopedia-mcp#readme",
  "bin": {
    "tokopedia-mcp": "build/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && tsx test/smoke.ts",
    "test:unit": "tsx test/variant-extractor.test.ts",
    "test:smoke": "tsx test/smoke.ts",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml,yaml}": "prettier --write",
    "*.ts": "eslint --fix"
  },
  "files": [
    "build",
    ".env.example",
    "docs",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tokopedia",
    "indonesia",
    "ecommerce",
    "marketplace",
    "product-search",
    "reviews",
    "discovery"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
