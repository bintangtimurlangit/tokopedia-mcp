{
  "name": "@bintangtimurlangit/tokopedia-mcp",
  "version": "2.0.0",
  "description": "A zero-config MCP server for discovering Tokopedia — product search with full dynamic filtering, product detail, customer reviews, and shop info. No login required.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bintangtimurlangit/tokopedia-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/bintangtimurlangit/tokopedia-mcp/issues"
  },
  "homepage": "https://github.com/bintangtimurlangit/tokopedia-mcp#readme",
  "bin": {
    "tokopedia-mcp": "build/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/smoke.ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "build",
    ".env.example",
    "docs",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tokopedia",
    "indonesia",
    "ecommerce",
    "marketplace",
    "product-search",
    "reviews",
    "discovery"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
