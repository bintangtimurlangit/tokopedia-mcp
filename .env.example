# ─────────────────────────────────────────────────────────────────────────────
# Tokopedia MCP — Environment Variables
#
# This server is public and read-only — there is NO authentication to configure.
# Everything below is optional tuning. Copy this file to .env only if you want
# to override a default.
# ─────────────────────────────────────────────────────────────────────────────

# Cache lifetime in milliseconds (default: 30000 = 30s)
CACHE_TTL_MS=30000

# Set to "true" to log startup info to stderr
DEBUG=false
